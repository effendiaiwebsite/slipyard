# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example IS committed
.env*
!.env.example

# design reference: source only
design-reference/**/node_modules/
design-reference/**/.next/
design-reference/**/dev.log

# playwright
/test-results/
/playwright-report/
/blob-report/
/e2e/.totp-secrets.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vendored browser libs copied from node_modules on postinstall (scripts/copy-vendor.mjs)
/public/vendor/
