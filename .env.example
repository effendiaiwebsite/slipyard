# ============================================================================
# Accountant CRM — environment variables
# Copy to .env and fill in. `src/lib/env.ts` validates at boot and fails fast,
# listing every missing/invalid var. Vars marked [optional] have dev fallbacks.
# ============================================================================

# --- Database ---------------------------------------------------------------
# App connection. In production this MUST be a non-superuser role (RLS is
# enforced via FORCE ROW LEVEL SECURITY; superusers bypass it).
# docker-compose dev default:
#   postgresql://crm_app:crm_app_dev_password@localhost:5432/accountant_crm
DATABASE_URL=

# [optional] Superuser/owner connection used ONLY by migrations and scripts
# (scripts/setup.ts, scripts/migrate.ts, scripts/reset.ts). Defaults to
# DATABASE_URL if unset — fine only when DATABASE_URL is itself an owner role
# (never in production).
DATABASE_ADMIN_URL=

# --- Auth -------------------------------------------------------------------
# Session/JWT signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=

# Field-level encryption key for SIN (AES-256-GCM). Generate: openssl rand -base64 32
# Key rotation: ciphertexts are prefixed with a key id; see docs/ARCHITECTURE.md.
FIELD_ENCRYPTION_KEY=

# Public URL of the app. Needed for magic links, invite links, Stripe
# redirects, and the Google OAuth callback. Dev: http://localhost:3000, or an
# ngrok/cloudflared tunnel URL when testing SMS/portal flows on a real phone.
APP_URL=http://localhost:3000

# [optional] Google OAuth (staff "Sign in with Google").
# Google Cloud Console -> OAuth consent + Web client.
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
# Login page hides the Google button when unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Billing (Stripe; required from M1) --------------------------------------
# Test mode until launch. STRIPE_WEBHOOK_SECRET comes from `stripe listen` in dev.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly per-seat price id (test product).
STRIPE_PRICE_ID=

# --- Storage (AWS S3, ca-central-1; required from M3) -------------------------
# IAM user scoped to this bucket + KMS key only. Bucket: private, Block Public
# Access ON, SSE-KMS, versioning ON.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ca-central-1
S3_BUCKET=
KMS_KEY_ID=

# --- SMS (Twilio) [optional until M5] -----------------------------------------
# Without keys, SMS goes to the in-app outbox (console + `outbox` table).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Canadian long code, E.164 (e.g. +14165551234)
TWILIO_FROM_NUMBER=

# --- Email -------------------------------------------------------------------
# outbox (default, dev) | ses | smtp
EMAIL_MODE=outbox
# When EMAIL_MODE=ses: uses AWS_* credentials above; set the from address.
SES_FROM_ADDRESS=
# When EMAIL_MODE=smtp:
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- AI (Anthropic) [optional until M8] ----------------------------------------
# Without a key, AiService runs in mock mode returning canned drafts.
ANTHROPIC_API_KEY=

# --- Observability [optional] ---------------------------------------------------
SENTRY_DSN=
# pino level: debug | info | warn | error (default info)
LOG_LEVEL=info
