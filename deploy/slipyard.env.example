# SlipYard production environment.
# Copy to /etc/slipyard/slipyard.env on the server, fill in REAL values,
# then: chown root:slipyard, chmod 640. NEVER commit the filled-in file.
# (setup-server.sh installs this skeleton for you.)

NODE_ENV=production
PORT=3000
APP_URL=https://slipyard.ca
JOBS_ENABLED=true

# --- Postgres (RDS, ca-central-1) ---------------------------------------------
# Both point at the RDS master/owner user. FORCE row-level security + the
# per-request app.org_id GUC enforce tenant isolation regardless of DB role,
# so no separate crm_app role is required (unlike the local dev setup).
DATABASE_URL=postgresql://USER:PASSWORD@your-db.xxxxxx.ca-central-1.rds.amazonaws.com:5432/slipyard
DATABASE_ADMIN_URL=postgresql://USER:PASSWORD@your-db.xxxxxx.ca-central-1.rds.amazonaws.com:5432/slipyard

# --- Auth / crypto (generate fresh: openssl rand -base64 32) -------------------
# Losing FIELD_ENCRYPTION_KEY makes every stored SIN unrecoverable — back it up
# in a password manager alongside the DB restore docs.
AUTH_SECRET=
FIELD_ENCRYPTION_KEY=

# --- Email (SES; slipyard.ca is a verified domain identity) -------------------
EMAIL_MODE=ses
SES_FROM_ADDRESS=notifications@slipyard.ca

# --- AWS S3 + KMS (ca-central-1) ----------------------------------------------
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
KMS_KEY_ID=

# --- ClamAV (runs on this same instance) --------------------------------------
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# --- Stripe (LIVE keys for production) ----------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Twilio -------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- AI (optional; per-org toggle still applies) ------------------------------
ANTHROPIC_API_KEY=

# --- Google OAuth (optional) --------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Backups (RDS already auto-backs-up; pnpm backup is belt-and-suspenders) ---
PG_DUMP=/usr/bin/pg_dump
